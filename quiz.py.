
# Interactive Quiz Application

questions = [
    {
        "question": "Which language is used for Python programming?",
        "options": ["A. HTML", "B. Python", "C. CSS", "D. SQL"],
        "answer": "B"
    },
    {
        "question": "What does CPU stand for?",
        "options": [
            "A. Central Processing Unit",
            "B. Computer Personal Unit",
            "C. Central Program Utility",
            "D. Control Processing User"
        ],
        "answer": "A"
    },
    {
        "question": "Which data structure follows FIFO?",
        "options": ["A. Stack", "B. Tree", "C. Queue", "D. Graph"],
        "answer": "C"
    },
    {
        "question": "Which symbol starts a comment in Python?",
        "options": ["A. //", "B. #", "C. <!--", "D. **"],
        "answer": "B"
    },
    {
        "question": "Which function displays output in Python?",
        "options": ["A. input()", "B. scan()", "C. print()", "D. show()"],
        "answer": "C"
    }
]

score = 0

print("=" * 35)
print("       WELCOME TO THE QUIZ!")
print("=" * 35)

for number, question in enumerate(questions, start=1):
    print(f"\nQuestion {number}: {question['question']}")

    for option in question["options"]:
        print(option)

    user_answer = input("Your answer (A/B/C/D): ").strip().upper()

    if user_answer == question["answer"]:
        print("Correct!")
        score += 1
    else:
        print("Incorrect!")

print("\n" + "=" * 35)
print(f"Your final score: {score}/{len(questions)}")
print("=" * 35)
